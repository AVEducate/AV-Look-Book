{
  "name": "av-look-book-desktop",
  "version": "0.2.118",
  "description": "AV Look Book \u2014 desktop shell (Electron; one-home loader with GitHub Release content updates)",
  "author": "AV Educate <Info@aveducate.com>",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "copy-html": "node -e \"const fs=require('fs');fs.mkdirSync('app',{recursive:true});fs.copyFileSync('../deploy/lookbook_builder.html','app/index.html');fs.copyFileSync('../deploy/quick_guide.html','app/quick_guide.html')\"",
    "start": "npm run copy-html && electron .",
    "dist:mac": "npm run copy-html && electron-builder --mac",
    "dist:win": "npm run copy-html && electron-builder --win",
    "dist": "npm run copy-html && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.aveducate.avlookbook",
    "productName": "AV Look Book",
    "artifactName": "AVLookBook-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "welcome-preload.js",
      "welcome.html",
      "build/icon.png",
      "app/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AVEducate",
        "repo": "AV-Look-Book",
        "releaseType": "release"
      }
    ],
    "afterPack": "build/afterPack.js",
    "fileAssociations": [
      {
        "ext": "avlb",
        "name": "AV Look Book Project",
        "description": "AV Look Book Project",
        "role": "Editor"
      }
    ],
    "dmg": {
      "backgroundColor": "#1c1c1e",
      "iconSize": 80,
      "window": {
        "width": 660,
        "height": 500
      },
      "contents": [
        {
          "x": 230,
          "y": 200
        },
        {
          "x": 430,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 330,
          "y": 394,
          "type": "file",
          "path": "build/dmg/Read Me First.html"
        }
      ]
    }
  }
}
